/**
 * `pnpm themes:import [source...]`: converts the JetBrains UI themes and editor schemes in
 * scripts/themes/sources/ into the app's theme files. Each source given (an extracted folder, a
 * plugin `.jar`, or one `.icls` / scheme `.xml`) is first copied into that folder, so it stays part
 * of every later import. Pass `--unmapped` to list the UI theme keys no role reads.
 */
import { spawnSync } from 'node:child_process'
import { cpSync, existsSync, mkdirSync, readdirSync, rmSync, writeFileSync } from 'node:fs'
import { basename, join, resolve } from 'node:path'
import { type ConvertedThemes, convertThemes } from './theme-conversion.mts'
import { openThemeSource } from './theme-source.mts'

const ROOT = resolve(import.meta.dirname, '../..')
const SOURCES = 'scripts/themes/sources'
const APP_CSS = 'src/renderer/src/assets/themes/app'
const EDITOR_JSON = 'src/renderer/src/assets/themes/editor'
const SHARED = 'src/shared/themes'
const DEFAULT_THEME = 'islands-dark'

/** Progress for whoever runs the script; it prints nothing else. */
const report = (line: string): void => {
  process.stdout.write(`${line}\n`)
}

const GENERATED = 'Generated by `pnpm themes:import` (scripts/themes); do not edit.'

function addSources(paths: string[]): void {
  for (const path of paths) {
    const target = join(SOURCES, basename(path))
    if (resolve(path) === resolve(ROOT, target)) continue
    if (existsSync(target))
      throw new Error(`${target} already exists; remove it to import ${path} again`)
    cpSync(path, target, { recursive: true })
    report(`Added ${path} as ${target}`)
  }
}

/** Replaces a folder's generated files with `files` (name → contents). */
function writeFolder(folder: string, files: Map<string, string>): string[] {
  rmSync(folder, { recursive: true, force: true })
  mkdirSync(folder, { recursive: true })
  return [...files].map(([name, contents]) => {
    const path = join(folder, name)
    writeFileSync(path, contents)
    return path
  })
}

function appThemeCss(theme: ConvertedThemes['app'][number]): string {
  const lines = [
    `/*`,
    ` * App theme "${theme.label}". ${GENERATED}`,
    ` * From the JetBrains UI theme and its parents:`,
    ...theme.origins.map((origin) => ` *   ${origin}`),
    ` */`,
    `:root[data-theme='${theme.id}'] {`,
    `  color-scheme: ${theme.dark ? 'dark' : 'light'};`,
    ...[...theme.roles].map(([role, value]) => `  --${role}: ${value};`),
    `}`
  ]
  return `${lines.join('\n')}\n`
}

const literal = (value: unknown): string => JSON.stringify(value).replaceAll('"', "'")

function catalogs(themes: ConvertedThemes): Map<string, string> {
  const app = themes.app.map(
    ({ id, label, dark, roles }) =>
      `  { id: ${literal(id)}, label: ${literal(label)}, dark: ${dark}, frame: ${literal(roles.get('frame'))} }`
  )
  const editor = themes.editor.map(
    ({ id, scheme }) =>
      `  { id: ${literal(id)}, label: ${literal(scheme.name)}, dark: ${scheme.dark} }`
  )
  const terminal = themes.terminal.map(
    ({ id, label, palette }) =>
      `  { id: ${literal(id)}, label: ${literal(label)}, palette: ${JSON.stringify(palette)} }`
  )
  return new Map([
    [
      'app-theme-catalog.ts',
      [
        `// ${GENERATED}`,
        `/** App themes: one CSS file each in src/renderer/src/assets/themes/app/. */`,
        `export const APP_THEMES = [\n${app.join(',\n')}\n] as const`,
        ''
      ].join('\n')
    ],
    [
      'editor-theme-catalog.ts',
      [
        `// ${GENERATED}`,
        `/** Editor themes: one scheme each in src/renderer/src/assets/themes/editor/. */`,
        `export const EDITOR_THEMES = [\n${editor.join(',\n')}\n] as const`,
        ''
      ].join('\n')
    ],
    [
      'terminal-theme-catalog.ts',
      [
        `// ${GENERATED}`,
        `import type { TerminalPalette } from './terminal-palette'`,
        '',
        `/** Terminal themes: the console colours of each editor scheme. */`,
        `export const TERMINAL_THEMES = [\n${terminal.join(',\n')}\n] as const satisfies readonly {`,
        `  id: string`,
        `  label: string`,
        `  palette: TerminalPalette`,
        `}[]`,
        ''
      ].join('\n')
    ]
  ])
}

function main(args: string[]): void {
  process.chdir(ROOT)
  const listUnmapped = args.includes('--unmapped')
  addSources(
    args
      .filter((arg) => arg !== '--unmapped')
      .map((arg) => resolve(process.env.INIT_CWD ?? ROOT, arg))
  )
  const sources = readdirSync(SOURCES).map((name) => openThemeSource(join(SOURCES, name)))
  const themes = convertThemes(sources)
  for (const kind of ['app', 'editor', 'terminal'] as const) {
    if (!themes[kind].some((theme) => theme.id === DEFAULT_THEME)) {
      throw new Error(`No ${kind} theme ${DEFAULT_THEME}, the default`)
    }
  }
  const written = [
    ...writeFolder(
      APP_CSS,
      new Map(themes.app.map((theme) => [`${theme.id}.css`, appThemeCss(theme)]))
    ),
    ...writeFolder(
      EDITOR_JSON,
      new Map(
        themes.editor.map(({ id, scheme }) => [
          `${id}.json`,
          `${JSON.stringify(scheme, null, 2)}\n`
        ])
      )
    ),
    ...[...catalogs(themes)].map(([name, contents]) => {
      const path = join(SHARED, name)
      writeFileSync(path, contents)
      return path
    })
  ]
  const imports = themes.app.map(({ id }) => `@import './app/${id}.css';`)
  writeFileSync(
    'src/renderer/src/assets/themes/app-themes.css',
    `/* ${GENERATED} */\n${imports.join('\n')}\n`
  )
  written.push('src/renderer/src/assets/themes/app-themes.css')
  const formatter = spawnSync(
    process.execPath,
    ['node_modules/oxfmt/bin/oxfmt', '--write', ...written],
    {
      stdio: 'inherit'
    }
  )
  if (formatter.status !== 0) throw new Error('oxfmt failed on the generated files')

  for (const theme of themes.app) {
    report(`App theme ${theme.id}: ${theme.unmapped.length} UI keys no role reads`)
    if (listUnmapped) for (const key of theme.unmapped.toSorted()) report(`  ${key}`)
  }
  report(`Editor and terminal themes: ${themes.editor.map(({ id }) => id).join(', ')}`)
}

main(process.argv.slice(2))
