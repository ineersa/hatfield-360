{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "react-hooks", "import", "unicorn", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "eqeqeq": "error",
    "no-console": [
      "warn",
      {
        "allow": ["warn", "error"]
      }
    ],
    "react/jsx-key": "error",
    "react/self-closing-comp": "error",
    "react/jsx-no-useless-fragment": [
      "error",
      {
        "allowExpressions": true
      }
    ],
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "error",
    "typescript/consistent-type-definitions": ["error", "type"],
    "typescript/consistent-type-imports": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "import/no-cycle": "error",
    "import/no-default-export": "error",
    "unicorn/filename-case": [
      "error",
      {
        "cases": {
          "kebabCase": true,
          "pascalCase": true
        }
      }
    ],
    "react/react-in-jsx-scope": "off",
    "import/no-unassigned-import": [
      "error",
      {
        "allow": ["**/*.css"]
      }
    ]
  },
  "overrides": [
    {
      "files": ["**/*.d.ts"],
      "rules": {
        "typescript/consistent-type-definitions": "off"
      }
    },
    {
      "files": ["electron.vite.config.ts", "config/*.mts"],
      "rules": {
        "import/no-default-export": "off"
      }
    },
    {
      "files": ["src/renderer/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "electron",
                "message": "Renderer reaches main only through window.desktop (preload)."
              }
            ],
            "patterns": [
              {
                "group": ["node:*"],
                "message": "Renderer is a sandboxed web page; no Node APIs."
              },
              {
                "group": ["**/main/**", "**/preload/**"],
                "message": "Import contracts from src/shared instead."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/shared/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "electron",
                "message": "src/shared must run in every process."
              }
            ],
            "patterns": [
              {
                "group": ["node:*"],
                "message": "src/shared must run in every process."
              },
              {
                "group": ["react", "react-dom"],
                "message": "src/shared must run in every process."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [".agents/**/scripts/**"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["src/main/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "electron",
                "importNames": ["ipcMain"],
                "message": "Register IPC handlers with handleTrusted from src/main/ipc/trusted-ipc.ts."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/main/ipc/trusted-ipc.ts"],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "ignorePatterns": ["out/**", ".claude/skills/**"]
}
