{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "react-hooks", "import", "unicorn", "oxc", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "eqeqeq": "error",
    "no-console": [
      "warn",
      {
        "allow": ["warn", "error"]
      }
    ],
    "react/jsx-key": "error",
    "react/self-closing-comp": "error",
    "react/jsx-no-useless-fragment": [
      "error",
      {
        "allowExpressions": true
      }
    ],
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "error",
    "typescript/consistent-type-definitions": ["error", "type"],
    "typescript/consistent-type-imports": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "import/no-cycle": "error",
    "import/no-default-export": "error",
    "unicorn/filename-case": [
      "error",
      {
        "cases": {
          "kebabCase": true,
          "pascalCase": true
        }
      }
    ],
    "react/react-in-jsx-scope": "off",
    "import/no-unassigned-import": [
      "error",
      {
        "allow": ["**/*.css"]
      }
    ],
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-require-imports": "error",
    "vitest/no-focused-tests": "error"
  },
  "overrides": [
    {
      "files": ["**/*.d.ts"],
      "rules": {
        "typescript/consistent-type-definitions": "off"
      }
    },
    {
      "files": ["electron.vite.config.ts", "config/**/*.mts", "config/**/*.mjs"],
      "rules": {
        "import/no-default-export": "off"
      }
    },
    {
      "files": ["**/*.mjs"],
      "rules": {
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-return": "off",
        "typescript/no-unsafe-argument": "off"
      }
    },
    {
      "files": [".agents/**/scripts/**"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["src/main/**"],
      "rules": {
        "hatfield/no-raw-ipc-registration": "error",
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "electron",
                "importNames": ["default"],
                "message": "Use named imports from 'electron' so IPC access stays visible to lint."
              }
            ],
            "patterns": [
              {
                "group": ["electron/*"],
                "message": "Import from 'electron' directly."
              },
              {
                "group": ["**/preload/**"],
                "message": "Main shares code with other processes only through src/shared."
              },
              {
                "group": ["**/renderer/**", "@/**"],
                "message": "Main shares code with other processes only through src/shared."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/main/ipc/trusted-ipc.ts"],
      "rules": {
        "hatfield/no-raw-ipc-registration": "off"
      }
    },
    {
      "files": ["src/preload/**"],
      "rules": {
        "import/no-nodejs-modules": "error",
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "electron",
                "allowImportNames": ["contextBridge", "ipcRenderer"],
                "message": "Preload is a thin bridge: contextBridge and ipcRenderer only."
              }
            ],
            "patterns": [
              {
                "group": ["electron/*"],
                "message": "Import from 'electron' directly."
              },
              {
                "group": ["**/main/**"],
                "message": "Preload depends only on src/shared contracts."
              },
              {
                "group": ["**/renderer/**", "@/**"],
                "message": "Preload depends only on src/shared contracts."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/renderer/**"],
      "rules": {
        "import/no-nodejs-modules": "error",
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "electron",
                "message": "Renderer reaches main only through window.desktop (preload)."
              }
            ],
            "patterns": [
              {
                "group": ["electron/*"],
                "message": "Renderer reaches main only through window.desktop (preload)."
              },
              {
                "group": ["**/main/**"],
                "message": "Import contracts from src/shared instead."
              },
              {
                "group": ["**/preload/**"],
                "message": "Import contracts from src/shared instead."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/shared/**"],
      "rules": {
        "import/no-nodejs-modules": "error",
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "electron",
                "message": "src/shared must run in every process."
              }
            ],
            "patterns": [
              {
                "group": ["electron/*", "react", "react/*", "react-dom", "react-dom/*"],
                "message": "src/shared must run in every process."
              },
              {
                "group": ["**/main/**"],
                "message": "src/shared must not depend on a process layer."
              },
              {
                "group": ["**/preload/**"],
                "message": "src/shared must not depend on a process layer."
              },
              {
                "group": ["**/renderer/**", "@/**"],
                "message": "src/shared must not depend on a process layer."
              }
            ]
          }
        ]
      }
    }
  ],
  "ignorePatterns": ["out/**", "release/**", ".claude/skills/**"],
  "jsPlugins": ["./config/oxlint/ipc-boundary-plugin.mjs"]
}
