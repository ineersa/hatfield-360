{
  "name": "hatfield-360",
  "version": "0.0.0",
  "private": true,
  "description": "Hatfield 360 desktop app",
  "license": "UNLICENSED",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "package": "electron-vite build && electron-builder --publish never",
    "package:local": "node scripts/install-locally.mjs",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --type-aware --deny-warnings",
    "typecheck": "tsc --noEmit -p config/tsconfig.node.json && tsc --noEmit -p config/tsconfig.web.json",
    "knip": "knip --config config/knip.json",
    "test": "vitest run --config config/vitest.config.mts",
    "test:watch": "vitest --config config/vitest.config.mts",
    "test:e2e": "electron-vite build && playwright test --config config/playwright.config.mts",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm knip && pnpm test",
    "verify": "pnpm check && pnpm test:e2e",
    "record:chat-cassettes": "node --experimental-transform-types --disable-warning=ExperimentalWarning --import ./scripts/typescript-imports.mjs scripts/record-chat-cassettes.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.109.1",
    "@anthropic-ai/claude-agent-sdk": "0.3.330",
    "@codingame/monaco-vscode-quickaccess-service-override": "37.6.1",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@headless-tree/core": "1.8.0",
    "@headless-tree/react": "1.8.0",
    "@radix-ui/react-use-controllable-state": "^1.3.0",
    "@streamdown/cjk": "^1.0.5",
    "@streamdown/code": "^2.0.1",
    "@streamdown/math": "^1.0.4",
    "@streamdown/mermaid": "^1.0.4",
    "@vscode/ripgrep": "1.18.0",
    "basedpyright": "1.40.2",
    "chokidar": "6.0.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "intelephense": "1.18.5",
    "motion": "^14.14.0",
    "nanoid": "^6.0.2",
    "node-pty": "1.1.0",
    "shiki": "^4.6.0",
    "streamdown": "^2.8.0",
    "typescript": "7.0.2",
    "use-stick-to-bottom": "^1.1.6",
    "vscode-jsonrpc": "10.0.0",
    "vscode-langservers-extracted": "4.10.0"
