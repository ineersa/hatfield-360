    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vscode": "npm:@codingame/monaco-vscode-extension-api@37.6.1",
    "vscode-languageclient": "10.1.2",
    "zod": "4.6.7",
    "zustand": "^5.1.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "oxlint --type-aware --deny-warnings --no-error-on-unmatched-pattern",
      "oxfmt --write --no-error-on-unmatched-pattern"
    ],
    "*.{json,css,md,yml,yaml}": [
      "oxfmt --write --no-error-on-unmatched-pattern"
    ]
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@12.18.0",
  "desktopName": "hatfield-360.desktop"
}
